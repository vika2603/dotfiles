# Report the state of the module system: what loaded, in what order, and
# whether the loader's invariants still hold.
emulate -L zsh

local m dep line

if (( _zmod_degraded )); then
  print -P "%F{red}%BDEGRADED%b%f dependency resolution failed; declaration order in use"
  print -P "%F{red}         the zmod: error printed at startup names the bad dependency%f\n"
fi

# Execution is partitioned by phase: every sync module runs, then every defer
# module. Within a phase the resolved order holds.
local -a sync_mods defer_mods
for m in $_zmod_order; do
  [[ ${_zmod_phase[$m]} == sync ]] && sync_mods+=($m) || defer_mods+=($m)
done

zdoctor::_row() {
  local m=$1
  line="  ${(r:20:)m}"
  case ${_zmod_status[$m]:-pending} in
    ok)      line+=" %F{green}ok     %f" ;;
    failed)  line+=" %F{red}FAILED %f" ;;
    missing) line+=" %F{red}MISSING%f" ;;
    *)       line+=" %F{yellow}pending%f" ;;
  esac
  dep=""
  [[ -n ${_zmod_after[$m]}  ]] && dep+=" after:${_zmod_after[$m]}"
  [[ -n ${_zmod_before[$m]} ]] && dep+=" before:${_zmod_before[$m]}"
  [[ -n $dep ]] && line+=" %F{242}${dep}%f"
  [[ -n ${_zmod_ms[$m]} ]] && line+=$(printf ' %F{242}%.1fms%%f' ${_zmod_ms[$m]})
  print -P -- $line
}

if (( ! $#_zmod_order )); then
  print -P "%BModules%b  %F{red}not resolved — zmod::load did not complete%f"
else
  print -P "%BModules%b (${#_zmod_names})  sync phase runs first, then defer"
  print -P "%F{242}  sync%f"
  for m in $sync_mods;  do zdoctor::_row $m; done
  print -P "%F{242}  defer%f"
  for m in $defer_mods; do zdoctor::_row $m; done
fi
unfunction zdoctor::_row

print -P "\n%BInvariants%b"
if [[ -z $_zmod_fpath_snapshot ]]; then
  print -P "  %F{yellow}--%f   fpath not sealed yet (completion module pending)"
elif zmod::check_fpath 2>/dev/null; then
  print -P "  %F{green}ok%f   fpath unchanged since it was sealed"
else
  print -P "  %F{red}FAIL%f fpath changed after sealing — see the zmod: error above"
fi
(( ${#_comps} )) \
  && print -P "  %F{green}ok%f   completion table populated (${#_comps} entries)" \
  || print -P "  %F{red}FAIL%f completion table is empty"

local -a broken
for m in $_zmod_names; do
  [[ ${_zmod_status[$m]} == (failed|missing) ]] && broken+=($m)
done
(( $#broken )) \
  && print -P "  %F{red}FAIL%f modules did not complete: ${(j:, :)broken}" \
  || print -P "  %F{green}ok%f   every module that ran returned success"

print -P "\n%BEnvironment defaults%b"
if (( ${#_zmod_env_want} )); then
  local var stale=0
  for var in ${(ok)_zmod_env_want}; do
    if [[ ${(P)var} == ${_zmod_env_want[$var]} ]]; then
      print -P "  %F{green}ok%f   ${(r:22:)var} ${(P)var}"
    else
      stale=1
      print -P "  %F{red}FAIL%f ${(r:22:)var} live '${(P)var}' != config '${_zmod_env_want[$var]}'"
    fi
  done
  (( stale )) && print -P "       %F{yellow}inherited from a parent shell; exec zsh cannot override it, open a new terminal%f"
else
  print -P "  %F{yellow}--%f   none recorded yet"
fi

print -P "\n%BCaches%b"
local cc=${XDG_CACHE_HOME:-$HOME/.cache}/zsh/carapace.zsh
if [[ -r $cc && -r $cc.sig ]]; then
  [[ "$(< $cc.sig)" == "${CARAPACE_BRIDGES}|${CARAPACE_EXCLUDES}" ]] \
    && print -P "  %F{green}ok%f   carapace" \
    || print -P "  %F{yellow}--%f   carapace stale, rebuilds next start"
else
  print -P "  %F{yellow}--%f   carapace absent"
fi
[[ $ZDOTDIR/.zsh_plugins.txt -nt $ZDOTDIR/.zsh_plugins.zsh ]] \
  && print -P "  %F{yellow}--%f   antidote bundle stale, rebuilds next start" \
  || print -P "  %F{green}ok%f   antidote bundle"
[[ $ZDOTDIR/.zcompdump -nt $ZDOTDIR/completions ]] \
  && print -P "  %F{green}ok%f   .zcompdump newer than completions/" \
  || print -P "  %F{yellow}--%f   .zcompdump older than completions/; rm it and exec zsh"

print -P "\n%F{242}ZSH_TRACE=1 exec zsh   per-module timings%f"
