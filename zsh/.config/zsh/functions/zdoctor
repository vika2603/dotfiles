# Report the state of the module system: what loaded, in what order, and
# whether the loader's invariants still hold.
emulate -L zsh

local m dep line

if (( _zmod_degraded )); then
  print -P "%F{red}%BDEGRADED%b%f dependency resolution failed; declaration order in use"
  print -P "%F{red}         the zmod: error printed at startup names the bad dependency%f\n"
fi

# Execution is partitioned by phase: every sync module runs, then every defer
# module. Within a phase the resolved order holds.
local -a sync_mods defer_mods
for m in $_zmod_order; do
  [[ ${_zmod_phase[$m]} == sync ]] && sync_mods+=($m) || defer_mods+=($m)
done

zdoctor::_row() {
  local m=$1
  line="  ${(r:20:)m}"
  case ${_zmod_status[$m]:-pending} in
    ok)      line+=" %F{green}ok     %f" ;;
    failed)  line+=" %F{red}FAILED %f" ;;
    missing) line+=" %F{red}MISSING%f" ;;
    *)       line+=" %F{yellow}pending%f" ;;
  esac
  dep=""
  [[ -n ${_zmod_after[$m]}  ]] && dep+=" after:${_zmod_after[$m]}"
  [[ -n ${_zmod_before[$m]} ]] && dep+=" before:${_zmod_before[$m]}"
  [[ -n $dep ]] && line+=" %F{242}${dep}%f"
  [[ -n ${_zmod_ms[$m]} ]] && line+=$(printf ' %F{242}%.1fms%%f' ${_zmod_ms[$m]})
  print -P -- $line
}

if (( ! $#_zmod_order )); then
  print -P "%BModules%b  %F{red}not resolved — zmod::load did not complete%f"
else
  print -P "%BModules%b (${#_zmod_names})  sync phase runs first, then defer"
  print -P "%F{242}  sync%f"
  for m in $sync_mods;  do zdoctor::_row $m; done
  print -P "%F{242}  defer%f"
  for m in $defer_mods; do zdoctor::_row $m; done
fi
unfunction zdoctor::_row

print -P "\n%BInvariants%b"
if (( ! _zmod_fpath_is_sealed )); then
  case ${_zmod_status[completion]:-pending} in
    ok)             print -P "  %F{red}FAIL%f completion module ran but never sealed fpath" ;;
    failed|missing) print -P "  %F{red}FAIL%f fpath never sealed: completion module ${_zmod_status[completion]}" ;;
    *)              print -P "  %F{yellow}--%f   fpath not sealed yet: completion module still pending" ;;
  esac
elif zmod::check_fpath 2>/dev/null; then
  print -P "  %F{green}ok%f   fpath unchanged since it was sealed"
else
  print -P "  %F{red}FAIL%f fpath changed after sealing — see the zmod: error above"
fi
# Only meaningful once the module responsible has actually run — reporting FAIL
# for work that is merely pending trains you to ignore this output.
case ${_zmod_status[completion]:-pending} in
  ok) (( ${#_comps} )) \
        && print -P "  %F{green}ok%f   completion table populated (${#_comps} entries)" \
        || print -P "  %F{red}FAIL%f completion module ran but the table is empty" ;;
  failed|missing)
      print -P "  %F{red}FAIL%f completion module ${_zmod_status[completion]}; completions unavailable" ;;
  *)  print -P "  %F{yellow}--%f   completion table: module still pending" ;;
esac

local -a broken
for m in $_zmod_names; do
  [[ ${_zmod_status[$m]} == (failed|missing) ]] && broken+=($m)
done
(( $#broken )) \
  && print -P "  %F{red}FAIL%f modules did not complete: ${(j:, :)broken}" \
  || print -P "  %F{green}ok%f   every module that ran returned success"

if [[ $_zmod_load_state == never ]]; then
  print -P "  %F{yellow}--%f   module files: zmod::load was never called"
elif [[ $_zmod_load_state == preflight-failed ]]; then
  print -P "  %F{red}FAIL%f no module files were read: \$ZDOTDIR/modules unusable"
else
  (( $#_zmod_bad_files )) \
    && print -P "  %F{red}FAIL%f module files that failed to source: ${(j:, :)_zmod_bad_files}" \
    || print -P "  %F{green}ok%f   every module file sourced cleanly"
  (( $#_zmod_bad_decls )) \
    && print -P "  %F{red}FAIL%f rejected declarations: ${(j:; :)_zmod_bad_decls}" \
    || print -P "  %F{green}ok%f   every declaration accepted"
fi

print -P "\n%BEnvironment defaults%b"
if (( ${#_zmod_env_want} )); then
  local var stale=0
  for var in ${(ok)_zmod_env_want}; do
    if [[ ${(P)var} == ${_zmod_env_want[$var]} ]]; then
      print -P "  %F{green}ok%f   ${(r:22:)var} ${(P)var}"
    else
      stale=1
      print -P "  %F{red}FAIL%f ${(r:22:)var} live '${(P)var}' != config '${_zmod_env_want[$var]}'"
    fi
  done
  (( stale )) && print -P "       %F{yellow}inherited from a parent shell; exec zsh cannot override it, open a new terminal%f"
else
  print -P "  %F{yellow}--%f   none recorded yet"
fi

print -P "\n%BCaches%b"
local cc=${XDG_CACHE_HOME:-$HOME/.cache}/zsh/carapace.zsh
if [[ ${_zmod_status[carapace]:-pending} == (failed|missing) ]]; then
  print -P "  %F{red}FAIL%f carapace module ${_zmod_status[carapace]}"
elif [[ ${_zmod_status[carapace]} != ok ]]; then
  print -P "  %F{yellow}--%f   carapace: module still pending"
elif [[ ! -r $cc || ! -r $cc.sig ]]; then
  print -P "  %F{yellow}--%f   carapace cache absent"
elif [[ "$(< $cc.sig)" == "${CARAPACE_BRIDGES}|${CARAPACE_EXCLUDES}" ]]; then
  print -P "  %F{green}ok%f   carapace"
else
  print -P "  %F{yellow}--%f   carapace stale, rebuilds next start"
fi
# `a -nt b` is false when either file is missing, so a bare -nt test reports a
# green tick for a comparison it could not make.
local manifest=$ZDOTDIR/.zsh_plugins.txt bundle=$ZDOTDIR/.zsh_plugins.zsh
if [[ ${_zmod_status[plugin-manager]:-pending} == (failed|missing) ]]; then
  print -P "  %F{red}FAIL%f antidote: plugin-manager module ${_zmod_status[plugin-manager]}"
elif [[ ${_zmod_status[plugin-manager]} != ok ]]; then
  print -P "  %F{yellow}--%f   antidote: module still pending"
elif [[ ! -r $manifest ]]; then
  print -P "  %F{red}FAIL%f antidote manifest missing: ${manifest:t}"
elif [[ ! -r $bundle ]]; then
  print -P "  %F{yellow}--%f   antidote bundle absent, builds next start"
elif [[ $manifest -nt $bundle ]]; then
  print -P "  %F{yellow}--%f   antidote bundle stale, rebuilds next start"
else
  print -P "  %F{green}ok%f   antidote bundle"
fi

local dump=$ZDOTDIR/.zcompdump
if [[ ! -r $dump ]]; then
  print -P "  %F{yellow}--%f   .zcompdump absent, rebuilds on next compinit"
elif [[ ! -d $ZDOTDIR/completions ]]; then
  print -P "  %F{yellow}--%f   .zcompdump present, no completions/ to compare against"
elif [[ $dump -nt $ZDOTDIR/completions ]]; then
  print -P "  %F{green}ok%f   .zcompdump newer than completions/"
else
  print -P "  %F{yellow}--%f   .zcompdump older than completions/; rm it and exec zsh"
fi

print -P "\n%F{242}ZSH_TRACE=1 exec zsh   per-module timings%f"
