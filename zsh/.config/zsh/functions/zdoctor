# Health check for the shell configuration.
#
#   zdoctor      report problems, or one line saying there are none
#   zdoctor -v   also print the module graph and loader bookkeeping
#
# The default output answers "is anything wrong", not "what did the loader do".
# Checks are about capabilities that should exist, so they can catch a module
# that returned success without actually having an effect.
emulate -L zsh

(( ${+functions[zmod::load]} )) || {
  print -P "%F{red}zmod is not loaded in this shell%f — source \$ZDOTDIR/lib/zmod.zsh first"
  return 1
}

local verbose=0
[[ $1 == (-v|--verbose) ]] && verbose=1

local -a problems notes
local m name cmd

# --- modules ----------------------------------------------------------------
local -a broken ran pending
for m in $_zmod_names; do
  case ${_zmod_status[$m]} in
    failed)  broken+=("$m (returned non-zero)") ;;
    missing) broken+=("$m (no zmod:$m defined)") ;;
    ok)      ran+=($m) ;;
    *)       pending+=($m) ;;
  esac
done
(( _zmod_degraded )) && problems+=("modules|dependency resolution failed; declaration order in use")
for m in $broken; do problems+=("module|$m"); done
(( $#_zmod_bad_files )) && problems+=("modules|files returned non-zero: ${(j:, :)_zmod_bad_files}")
(( $#_zmod_bad_decls )) && problems+=("modules|rejected declarations: ${(j:; :)_zmod_bad_decls}")
[[ ${_zmod_load_state:-never} == sourced ]] || \
  problems+=("modules|load state is ${_zmod_load_state:-never}, not a completed load")

# --- fpath / completions ----------------------------------------------------
if (( _zmod_fpath_is_sealed )); then
  zmod::check_fpath 2>/dev/null || problems+=("fpath|changed after compinit; those completions are unregistered")
elif [[ ${_zmod_status[completion]} == (failed|missing) ]]; then
  problems+=("fpath|never sealed: completion module ${_zmod_status[completion]}")
fi

# Every file in completions/ names the command it completes, so the directory
# itself says what should be registered. No hardcoded list to drift.
if [[ ${_zmod_status[completion]} == ok ]]; then
  (( ${#_comps} )) || problems+=("completion|compinit ran but the table is empty")
  local f
  for f in $ZDOTDIR/completions/_*(N-.); do
    name=${${f:t}#_}
    [[ -n ${_comps[$name]} ]] || problems+=("completion|${f:t} is present but '$name' has no completion")
  done
fi

# --- declared intent that can fail silently ---------------------------------
for name in ${(ok)_zmod_alias_want}; do
  cmd=${_zmod_alias_want[$name]}
  if (( ! $+commands[$cmd] )); then
    notes+=("$name|$cmd is not installed, alias skipped")
  elif [[ -z ${aliases[$name]} ]]; then
    problems+=("$name|$cmd is installed but the alias was never defined")
  fi
done

for name in ${(ok)_zmod_env_want}; do
  [[ ${(P)name} == ${_zmod_env_want[$name]} ]] || \
    problems+=("$name|inherited '${(P)name}', config wants '${_zmod_env_want[$name]}'; needs a new terminal")
done

# --- caches: informational, they rebuild themselves -------------------------
local cc=${XDG_CACHE_HOME:-$HOME/.cache}/zsh/carapace.zsh
[[ ${_zmod_status[carapace]} == ok && -r $cc && -r $cc.sig \
   && "$(< $cc.sig)" != "${CARAPACE_BRIDGES}|${CARAPACE_EXCLUDES}" ]] && \
  notes+=("carapace|cache signature stale, rebuilds next start")
[[ ${_zmod_status[plugin-manager]} == ok && -r $ZDOTDIR/.zsh_plugins.txt \
   && $ZDOTDIR/.zsh_plugins.txt -nt $ZDOTDIR/.zsh_plugins.zsh ]] && \
  notes+=("antidote|bundle stale, rebuilds next start")
[[ -r $ZDOTDIR/.zcompdump && -d $ZDOTDIR/completions \
   && ! $ZDOTDIR/.zcompdump -nt $ZDOTDIR/completions ]] && \
  notes+=("compdump|older than completions/; rm \$ZDOTDIR/.zcompdump && exec zsh")

# --- report -----------------------------------------------------------------
zdoctor::_lines() {
  local entry
  for entry in "$@"; do
    printf '  %s%-10s%s %s\n' $'\e[2m' ${entry%%|*} $'\e[0m' ${entry#*|}
  done
}

if (( $#problems )); then
  print -P "%F{red}zsh: ${#problems} problem$( (( $#problems > 1 )) && print s )%f"
  zdoctor::_lines "${problems[@]}"
else
  print -P "%F{green}zsh: ok%f — ${#ran} modules, ${#_comps} completions$( (( $#pending )) && print ", ${#pending} deferred still pending")"
fi
(( $#notes )) && { print -P "%F{yellow}notes%f"; zdoctor::_lines "${notes[@]}" }
unfunction zdoctor::_lines

(( verbose )) || { (( $#problems )) && print -P "%F{242}  zdoctor -v for the module graph%f"; return }

# --- verbose: loader internals ----------------------------------------------
print -P "\n%BModules%b (${#_zmod_names})  every sync module runs, then every defer module"
local phase line dep
for phase in sync defer; do
  print -P "%F{242}  $phase%f"
  for m in $_zmod_order; do
    [[ ${_zmod_phase[$m]} == $phase ]] || continue
    line="  ${(r:20:)m}"
    case ${_zmod_status[$m]:-pending} in
      ok)      line+=" %F{green}ok     %f" ;;
      failed)  line+=" %F{red}FAILED %f" ;;
      missing) line+=" %F{red}MISSING%f" ;;
      *)       line+=" %F{yellow}pending%f" ;;
    esac
    dep=""
    [[ -n ${_zmod_after[$m]}  ]] && dep+=" after:${_zmod_after[$m]}"
    [[ -n ${_zmod_before[$m]} ]] && dep+=" before:${_zmod_before[$m]}"
    [[ -n $dep ]] && line+=" %F{242}$dep%f"
    [[ -n ${_zmod_ms[$m]} ]] && line+=$(printf ' %F{242}%.1fms%%f' ${_zmod_ms[$m]})
    print -P -- $line
  done
done

print -P "\n%BLoader%b"
printf '  %-20s %s\n' 'load state'   "${_zmod_load_state:-never}"
printf '  %-20s %s\n' 'registration' "$( (( _zmod_reg_closed )) && print closed || print open )"
printf '  %-20s %s\n' 'fpath'        "$( (( _zmod_fpath_is_sealed )) \
  && print "sealed, ${#_zmod_fpath_sealed} entries" || print 'not sealed' )"
printf '  %-20s %s\n' 'declarations' "${#_zmod_names} accepted, ${#_zmod_bad_decls} rejected"
printf '  %-20s %s\n' 'files'        "${#_zmod_bad_files} returned non-zero"
print -P "\n%F{242}ZSH_TRACE=1 exec zsh   per-module timings%f"
